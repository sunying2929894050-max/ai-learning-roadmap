# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# DeepSeek API key — get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek base URL (default is fine unless you use a mirror)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Allowed models (comma-separated); first is the default
# Options: deepseek-chat, deepseek-reasoner
# (no env knob needed — controlled in code whitelist)

# Max tokens the server will ever send upstream (clients asking more are clamped)
MAX_TOKENS_CAP=1024

# Max request body size in bytes
MAX_BODY_BYTES=32768

# Max total characters across all messages in one request
MAX_MSG_CHARS=8000

# Per-IP requests per 60 seconds
RATE_IP_LIMIT=10

# Global daily call cap across all IPs
RATE_DAILY_LIMIT=2000

# Comma-separated allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=https://sunying2929894050-max.github.io,http://localhost:8080,http://localhost:8765
