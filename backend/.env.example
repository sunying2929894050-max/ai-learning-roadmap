# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# This service holds NO API keys — users supply their own via X-User-Key.

# DeepSeek base URL (default is fine unless you use a mirror)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Max tokens the server will ever forward upstream (clients asking more are clamped)
MAX_TOKENS_CAP=2048

# Max request body size in bytes
MAX_BODY_BYTES=65536

# Max total characters across all messages in one request
MAX_MSG_CHARS=16000

# Per-IP requests per 60 seconds (bandwidth abuse guard, not token protection)
RATE_IP_LIMIT=30

# Comma-separated allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=https://sunying2929894050-max.github.io,http://localhost:8080,http://localhost:8765
